datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  active
  suspended
  deleted
}

enum CampusRole {
  student
  merchant
  merchant_staff
  campus_moderator
  campus_admin
}

enum MembershipStatus {
  active
  pending
  revoked
}

enum BusinessStatus {
  pending
  verified
  rejected
  suspended
}

enum BusinessStaffRole {
  manager
  staff
}

enum OrderStatus {
  pending
  accepted
  preparing
  ready
  completed
  cancelled
  rejected
}

enum PaymentStatus {
  unpaid
  pending
  paid
  failed
  refunded
}

enum BookingStatus {
  requested
  confirmed
  completed
  cancelled
  rejected
}

enum ReportStatus {
  pending
  in_review
  resolved
  dismissed
}

enum TransportTripStatus {
  scheduled
  in_transit
  completed
  cancelled
}

enum ReservationStatus {
  reserved
  confirmed
  boarded
  cancelled
}

enum HousingPropertyType {
  room
  apartment
  shared_house
}

enum ViewingRequestStatus {
  pending
  accepted
  declined
  completed
}

enum EventRsvpStatus {
  registered
  attended
  cancelled
}

enum LearningResourceType {
  lecture_note
  past_exam
  syllabus
  lab_manual
}

enum AcademicLevel {
  undergraduate
  postgraduate
  doctoral
  tvet
}

enum StudentIdStatus {
  active
  suspended
  graduated
  lost
}

enum WalletStatus {
  active
  frozen
  closed
}

enum WalletType {
  student
  merchant
  campus_treasury
  system_fee
}

enum LedgerEntryType {
  credit
  debit
}

enum TransactionCategory {
  topup_telebirr
  topup_cbe_birr
  topup_chapa
  p2p_transfer
  merchant_payment
  transport_payment
  cafeteria_payment
  housing_deposit
  refund
  system_fee
}

enum TransactionState {
  pending
  succeeded
  failed
  reversed
}

enum DietaryPreference {
  non_fasting
  fasting
  vegetarian
  halal
}

enum MealPeriod {
  breakfast
  lunch
  dinner
}

model Campus {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  city      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  memberships        CampusMembership[]
  businesses         Business[]
  categories         Category[]
  orders             Order[]
  announcements      Announcement[]
  auditLogs          AuditLog[]
  transportRoutes    TransportRoute[]
  housingListings    HousingListing[]
  events             CampusEvent[]
  learningResources  LearningResource[]
  studentProfiles    StudentProfile[]
  wallets            Wallet[]
  walletTransactions WalletTransaction[]
  mealPlans          MealPlan[]

  @@map("campuses")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String?    @unique
  phone         String?    @unique
  displayName   String     @map("display_name")
  passwordHash  String?    @map("password_hash")
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  status        UserStatus @default(active)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  sessions           Session[]
  accounts           Account[]
  memberships        CampusMembership[]
  ownedBusinesses    Business[]              @relation("BusinessOwner")
  staffRoles         BusinessStaff[]
  orders             Order[]                 @relation("CustomerOrders")
  bookings           Booking[]               @relation("CustomerBookings")
  announcements      Announcement[]          @relation("UserAnnouncements")
  notifications      Notification[]
  auditLogs          AuditLog[]              @relation("ActorAuditLogs")
  reportsFiled       Report[]                @relation("ReporterUser")
  ticketReservations TicketReservation[]     @relation("PassengerUser")
  housingOwned       HousingListing[]        @relation("LandlordHousing")
  viewingRequests    HousingViewingRequest[] @relation("StudentViewingRequests")
  eventsOrganized    CampusEvent[]           @relation("EventOrganizer")
  eventRsvps         EventRsvp[]             @relation("UserEventRsvps")
  learningResources  LearningResource[]      @relation("UploaderLearningResources")
  studentProfile     StudentProfile?
  wallet             Wallet?
  staffMealScans     MealScanLog[]           @relation("StaffMealScans")

  @@map("users")
}

model CampusMembership {
  userId   String           @map("user_id") @db.Uuid
  campusId String           @map("campus_id") @db.Uuid
  role     CampusRole
  status   MembershipStatus @default(active)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@id([userId, campusId, role])
  @@map("campus_memberships")
}

model Business {
  id          String         @id @default(uuid()) @db.Uuid
  campusId    String         @map("campus_id") @db.Uuid
  ownerId     String         @map("owner_id") @db.Uuid
  name        String
  description String?
  status      BusinessStatus @default(pending)
  createdAt   DateTime       @default(now()) @map("created_at")

  campus   Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  owner    User            @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  staff    BusinessStaff[]
  products Product[]
  orders   Order[]
  bookings Booking[]
  wallet   Wallet?

  @@index([campusId, status], name: "idx_businesses_campus_status")
  @@map("businesses")
}

model BusinessStaff {
  businessId String            @map("business_id") @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  role       BusinessStaffRole

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([businessId, userId])
  @@map("business_staff")
}

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  campusId String? @map("campus_id") @db.Uuid
  name     String
  slug     String

  campus   Campus?   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([campusId, slug])
  @@map("categories")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  categoryId    String?  @map("category_id") @db.Uuid
  name          String
  description   String?
  priceMinor    BigInt   @map("price_minor")
  currency      String   @default("ETB") @db.Char(3)
  stockQuantity Int?     @map("stock_quantity")
  isAvailable   Boolean  @default(true) @map("is_available")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([businessId, isAvailable], name: "idx_products_business_available")
  @@map("products")
}

model Order {
  id            String        @id @default(uuid()) @db.Uuid
  campusId      String        @map("campus_id") @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  businessId    String        @map("business_id") @db.Uuid
  status        OrderStatus   @default(pending)
  paymentStatus PaymentStatus @default(unpaid) @map("payment_status")
  currency      String        @default("ETB") @db.Char(3)
  subtotalMinor BigInt        @map("subtotal_minor")
  feeMinor      BigInt        @default(0) @map("fee_minor")
  totalMinor    BigInt        @map("total_minor")
  createdAt     DateTime      @default(now()) @map("created_at")

  campus   Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  customer User        @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  business Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([customerId, createdAt(sort: Desc)], name: "idx_orders_customer_created")
  @@index([businessId, status], name: "idx_orders_business_status")
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid
  productName    String  @map("product_name")
  unitPriceMinor BigInt  @map("unit_price_minor")
  quantity       Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Booking {
  id          String        @id @default(uuid()) @db.Uuid
  customerId  String        @map("customer_id") @db.Uuid
  businessId  String        @map("business_id") @db.Uuid
  serviceName String        @map("service_name")
  startsAt    DateTime      @map("starts_at")
  status      BookingStatus @default(requested)
  createdAt   DateTime      @default(now()) @map("created_at")

  customer User     @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt], name: "idx_bookings_business_start")
  @@map("bookings")
}

model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  orderId             String?       @map("order_id") @db.Uuid
  reservationId       String?       @map("reservation_id") @db.Uuid
  walletId            String?       @map("wallet_id") @db.Uuid
  walletTransactionId String?       @map("wallet_transaction_id") @db.Uuid
  provider            String
  providerReference   String?       @map("provider_reference")
  amountMinor         BigInt        @map("amount_minor")
  currency            String        @default("ETB") @db.Char(3)
  status              PaymentStatus @default(pending)
  createdAt           DateTime      @default(now()) @map("created_at")

  order             Order?             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reservation       TicketReservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  wallet            Wallet?            @relation("WalletPayments", fields: [walletId], references: [id], onDelete: SetNull)
  walletTransaction WalletTransaction? @relation("TransactionPayments", fields: [walletTransactionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerReference])
  @@map("payments")
}

model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  campusId    String    @map("campus_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  title       String
  body        String
  publishedAt DateTime? @map("published_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  author User   @relation("UserAnnouncements", fields: [authorId], references: [id], onDelete: Restrict)

  @@map("announcements")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], name: "idx_notifications_user_created")
  @@map("notifications")
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  entityType String       @map("entity_type")
  entityId   String       @map("entity_id") @db.Uuid
  reason     String
  details    String?
  status     ReportStatus @default(pending)
  createdAt  DateTime     @default(now()) @map("created_at")

  reporter User @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Restrict)

  @@map("reports")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  campusId   String?  @map("campus_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  actor  User?   @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model TransportOperator {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  logoUrl   String?  @map("logo_url")
  phone     String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  trips Trip[]

  @@map("transport_operators")
}

model TransportRoute {
  id                   String   @id @default(uuid()) @db.Uuid
  campusId             String?  @map("campus_id") @db.Uuid
  origin               String
  destination          String
  departureStation     String   @map("departure_station")
  arrivalStation       String   @map("arrival_station")
  distanceKm           Int?     @map("distance_km")
  estimatedDurationMin Int?     @map("estimated_duration_min")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")

  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)
  trips  Trip[]

  @@map("transport_routes")
}

model Trip {
  id             String              @id @default(uuid()) @db.Uuid
  operatorId     String              @map("operator_id") @db.Uuid
  routeId        String              @map("route_id") @db.Uuid
  vehicleNumber  String              @map("vehicle_number")
  vehicleType    String              @default("Bus") @map("vehicle_type")
  departureTime  DateTime            @map("departure_time")
  arrivalTime    DateTime?           @map("arrival_time")
  totalSeats     Int                 @map("total_seats")
  availableSeats Int                 @map("available_seats")
  priceMinor     BigInt              @map("price_minor")
  currency       String              @default("ETB") @db.Char(3)
  status         TransportTripStatus @default(scheduled)
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at")

  operator     TransportOperator   @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  route        TransportRoute      @relation(fields: [routeId], references: [id], onDelete: Restrict)
  reservations TicketReservation[]

  @@index([routeId, departureTime], name: "idx_trips_route_departure")
  @@map("trips")
}

model TicketReservation {
  id             String            @id @default(uuid()) @db.Uuid
  tripId         String            @map("trip_id") @db.Uuid
  passengerId    String            @map("passenger_id") @db.Uuid
  seatNumber     Int               @map("seat_number")
  passengerName  String            @map("passenger_name")
  passengerPhone String            @map("passenger_phone")
  qrCode         String            @unique @map("qr_code")
  amountMinor    BigInt            @map("amount_minor")
  currency       String            @default("ETB") @db.Char(3)
  status         ReservationStatus @default(reserved)
  paymentStatus  PaymentStatus     @default(unpaid) @map("payment_status")
  createdAt      DateTime          @default(now()) @map("created_at")

  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  passenger User      @relation("PassengerUser", fields: [passengerId], references: [id], onDelete: Restrict)
  payments  Payment[]

  @@unique([tripId, seatNumber])
  @@index([passengerId, createdAt(sort: Desc)], name: "idx_reservations_passenger")
  @@map("ticket_reservations")
}

model HousingListing {
  id             String              @id @default(uuid()) @db.Uuid
  campusId       String              @map("campus_id") @db.Uuid
  landlordId     String              @map("landlord_id") @db.Uuid
  title          String
  description    String?
  location       String
  propertyType   HousingPropertyType @default(room) @map("property_type")
  rentMinor      BigInt              @map("rent_minor")
  currency       String              @default("ETB") @db.Char(3)
  hasWater       Boolean             @default(true) @map("has_water")
  hasElectricity Boolean             @default(true) @map("has_electricity")
  hasWifi        Boolean             @default(false) @map("has_wifi")
  contactPhone   String              @map("contact_phone")
  isAvailable    Boolean             @default(true) @map("is_available")
  imageUrl       String?             @map("image_url")
  createdAt      DateTime            @default(now()) @map("created_at")

  campus          Campus                  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  landlord        User                    @relation("LandlordHousing", fields: [landlordId], references: [id], onDelete: Restrict)
  viewingRequests HousingViewingRequest[]

  @@index([campusId, isAvailable], name: "idx_housing_campus_available")
  @@map("housing_listings")
}

model HousingViewingRequest {
  id            String               @id @default(uuid()) @db.Uuid
  listingId     String               @map("listing_id") @db.Uuid
  studentId     String               @map("student_id") @db.Uuid
  preferredDate DateTime             @map("preferred_date")
  studentPhone  String               @map("student_phone")
  message       String?
  status        ViewingRequestStatus @default(pending)
  createdAt     DateTime             @default(now()) @map("created_at")

  listing HousingListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  student User           @relation("StudentViewingRequests", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt(sort: Desc)], name: "idx_viewing_student")
  @@map("housing_viewing_requests")
}

model CampusEvent {
  id            String    @id @default(uuid()) @db.Uuid
  campusId      String    @map("campus_id") @db.Uuid
  organizerId   String    @map("organizer_id") @db.Uuid
  title         String
  description   String
  venue         String
  startsAt      DateTime  @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  category      String    @default("Campus Life")
  entryFeeMinor BigInt    @default(0) @map("entry_fee_minor")
  currency      String    @default("ETB") @db.Char(3)
  maxAttendees  Int?      @map("max_attendees")
  bannerUrl     String?   @map("banner_url")
  createdAt     DateTime  @default(now()) @map("created_at")

  campus    Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  organizer User        @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  rsvps     EventRsvp[]

  @@index([campusId, startsAt], name: "idx_events_campus_starts")
  @@map("campus_events")
}

model EventRsvp {
  id         String          @id @default(uuid()) @db.Uuid
  eventId    String          @map("event_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  ticketCode String          @unique @map("ticket_code")
  status     EventRsvpStatus @default(registered)
  createdAt  DateTime        @default(now()) @map("created_at")

  event CampusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User        @relation("UserEventRsvps", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, createdAt(sort: Desc)], name: "idx_rsvp_user")
  @@map("event_rsvps")
}

model LearningResource {
  id            String               @id @default(uuid()) @db.Uuid
  campusId      String               @map("campus_id") @db.Uuid
  uploaderId    String               @map("uploader_id") @db.Uuid
  title         String
  description   String?
  department    String
  courseCode    String               @map("course_code")
  resourceType  LearningResourceType @default(lecture_note) @map("resource_type")
  fileUrl       String               @map("file_url")
  downloadCount Int                  @default(0) @map("download_count")
  isApproved    Boolean              @default(true) @map("is_approved")
  createdAt     DateTime             @default(now()) @map("created_at")

  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  uploader User   @relation("UploaderLearningResources", fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([campusId, department], name: "idx_learning_campus_dept")
  @@index([courseCode], name: "idx_learning_course")
  @@map("learning_resources")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_session_user")
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId], name: "idx_account_user")
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier], name: "idx_verification_identifier")
  @@map("verifications")
}

model StudentProfile {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @unique @map("user_id") @db.Uuid
  campusId        String          @map("campus_id") @db.Uuid
  studentIdNumber String          @map("student_id_number")
  college         String
  department      String
  academicLevel   AcademicLevel   @default(undergraduate) @map("academic_level")
  batchYear       Int             @map("batch_year")
  emergencyPhone  String?         @map("emergency_phone")
  idCardStatus    StudentIdStatus @default(active) @map("id_card_status")
  qrSecret        String          @default(uuid()) @map("qr_secret")
  issuedAt        DateTime        @default(now()) @map("issued_at")
  expiresAt       DateTime        @map("expires_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus     Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  mealPasses MealPass[]

  @@unique([campusId, studentIdNumber])
  @@index([campusId, department], name: "idx_student_campus_dept")
  @@map("student_profiles")
}

model Wallet {
  id           String       @id @default(uuid()) @db.Uuid
  campusId     String       @map("campus_id") @db.Uuid
  userId       String?      @unique @map("user_id") @db.Uuid
  businessId   String?      @unique @map("business_id") @db.Uuid
  walletType   WalletType   @default(student) @map("wallet_type")
  currency     String       @default("ETB") @db.Char(3)
  balanceMinor BigInt       @default(0) @map("balance_minor")
  status       WalletStatus @default(active)
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campus   Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  entries  LedgerEntry[]
  payments Payment[]     @relation("WalletPayments")

  @@index([campusId, walletType], name: "idx_wallets_campus_type")
  @@index([campusId, status], name: "idx_wallets_campus_status")
  @@map("wallets")
}

model WalletTransaction {
  id              String              @id @default(uuid()) @db.Uuid
  referenceNumber String              @unique @map("reference_number")
  idempotencyKey  String?             @unique @map("idempotency_key")
  campusId        String              @map("campus_id") @db.Uuid
  category        TransactionCategory
  state           TransactionState    @default(pending)
  amountMinor     BigInt              @map("amount_minor")
  feeMinor        BigInt              @default(0) @map("fee_minor")
  currency        String              @default("ETB") @db.Char(3)
  description     String
  metadata        Json?
  createdAt       DateTime            @default(now()) @map("created_at")
  completedAt     DateTime?           @map("completed_at")

  campus   Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  entries  LedgerEntry[]
  payments Payment[]     @relation("TransactionPayments")

  @@index([campusId, createdAt(sort: Desc)], name: "idx_tx_campus_created")
  @@map("wallet_transactions")
}

model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  transactionId String          @map("transaction_id") @db.Uuid
  walletId      String          @map("wallet_id") @db.Uuid
  entryType     LedgerEntryType @map("entry_type")
  amountMinor   BigInt          @map("amount_minor")
  currency      String          @default("ETB") @db.Char(3)
  balanceAfter  BigInt          @map("balance_after")
  createdAt     DateTime        @default(now()) @map("created_at")

  transaction WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt(sort: Desc)], name: "idx_ledger_wallet_created")
  @@map("ledger_entries")
}

model MealPlan {
  id                  String   @id @default(uuid()) @db.Uuid
  campusId            String   @map("campus_id") @db.Uuid
  name                String
  description         String?
  priceMinor          BigInt?  @map("price_minor")
  billingDurationDays Int?     @map("billing_duration_days")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  campus Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  passes MealPass[]

  @@map("meal_plans")
}

model MealPass {
  id                String            @id @default(uuid()) @db.Uuid
  studentProfileId  String            @map("student_profile_id") @db.Uuid
  mealPlanId        String            @map("meal_plan_id") @db.Uuid
  dietaryPreference DietaryPreference @default(non_fasting) @map("dietary_preference")
  passCode          String            @unique @map("pass_code")
  validFrom         DateTime          @map("valid_from")
  validUntil        DateTime          @map("valid_until")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  mealPlan       MealPlan       @relation(fields: [mealPlanId], references: [id], onDelete: Restrict)
  scans          MealScanLog[]

  @@index([studentProfileId, isActive], name: "idx_meal_pass_student")
  @@map("meal_passes")
}

model MealScanLog {
  id          String     @id @default(uuid()) @db.Uuid
  mealPassId  String     @map("meal_pass_id") @db.Uuid
  scannedById String     @map("scanned_by_id") @db.Uuid
  mealPeriod  MealPeriod @map("meal_period")
  scannedDate DateTime   @map("scanned_date") @db.Date
  scannedAt   DateTime   @default(now()) @map("scanned_at")
  diningHall  String     @map("dining_hall")

  mealPass  MealPass @relation(fields: [mealPassId], references: [id], onDelete: Cascade)
  scannedBy User     @relation("StaffMealScans", fields: [scannedById], references: [id], onDelete: Restrict)

  @@unique([mealPassId, scannedDate, mealPeriod], name: "uq_meal_pass_daily_period")
  @@index([scannedDate, mealPeriod, diningHall], name: "idx_meal_scans_date_hall")
  @@map("meal_scan_logs")
}
