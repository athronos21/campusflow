# ==============================================================
# CampusFlow Environment Configuration (.env.example)
# Copy this file to .env for local development
# ==============================================================

# Database Connection (Docker Compose default)
DATABASE_URL="postgresql://campusflow:campusflow_dev_password@localhost:5432/campusflow_db?schema=public"

# NestJS API Server
PORT=4000
API_URL="http://localhost:4000"
JWT_SECRET="campusflow_dev_jwt_secret_change_in_production_min32chars"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="7d"

# Next.js Web Application
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
BETTER_AUTH_SECRET="campusflow_dev_better_auth_secret_key_32chars_min"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Flutter Mobile Client (configured in apps/mobile/lib/core/api/api_endpoints.dart)
# - Android Emulator: http://10.0.2.2:4000/api/v1
# - iOS Simulator / Local: http://localhost:4000/api/v1
# - Physical Device (Local Wi-Fi): http://<YOUR_LAN_IP>:4000/api/v1
FLUTTER_API_BASE_URL="http://10.0.2.2:4000/api/v1"
